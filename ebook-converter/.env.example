# Redis
# Connection URL for Redis (used by rate limiter and job queue)
# Default: localhost:6379, change in production
REDIS_URL=redis://localhost:6379

# Upload config
# Local directory for storing uploaded files during conversion
UPLOAD_DIR=/tmp/ebook-uploads
# Maximum file size for conversion (MB)
MAX_FILE_SIZE_MB=10
# Path to Calibre's ebook-convert binary
CALIBRE_PATH=ebook-convert

# Cloudflare R2 (optional, falls back to local /tmp)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ebook-temp

# Supabase (optional, for authentication & user data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Rate Limiting ---
# Conversion API: max requests per IP per 60s window (default 20)
CONVERT_RATE_LIMIT_MAX=20
# Anonymous general interface: max requests per IP per 60s window (default 60)
ANONYMOUS_RATE_LIMIT_MAX=60
# Rate limit window in milliseconds (default 60000 = 60 seconds)
RATE_LIMIT_WINDOW_MS=60000
# Whether to allow requests when Redis is unavailable
# true = degrade gracefully, false = reject all requests
RATE_LIMIT_SKIP_ON_REDIS_DOWN=true

# --- CORS ---
# Comma-separated list of allowed origins for cross-origin API requests
# Default: same as NEXT_PUBLIC_APP_URL
CORS_ORIGINS=https://bookconv.com

# --- Lemon Squeezy (optional, for subscription payments) ---
# API key from Lemon Squeezy dashboard (Settings > API)
LEMON_SQUEEZY_API_KEY=
# Store ID from Lemon Squeezy dashboard (URL contains it)
LEMON_SQUEEZY_STORE_ID=
# Webhook signing secret — used to verify webhook signature authenticity
# Without this, webhook signature verification is skipped (security risk!)
LEMON_SQUEEZY_WEBHOOK_SECRET=
# Variant ID for Pro monthly plan (from Lemon Squeezy product settings)
LEMON_SQUEEZY_PRO_MONTHLY_VARIANT_ID=
# Variant ID for API plan (from Lemon Squeezy product settings)
LEMON_SQUEEZY_API_MONTHLY_VARIANT_ID=
