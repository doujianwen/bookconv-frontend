# Redis
REDIS_URL=redis://localhost:6379

# Upload config
UPLOAD_DIR=/tmp/ebook-uploads
MAX_FILE_SIZE_MB=10
CALIBRE_PATH=ebook-convert

# Cloudflare R2 (optional, falls back to local /tmp)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ebook-temp

# Supabase (optional)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Rate Limiting ---
# 转换接口：每 IP 60 秒最大请求数（默认 20）
CONVERT_RATE_LIMIT_MAX=20
# 匿名通用接口：每 IP 60 秒最大请求数（默认 60）
ANONYMOUS_RATE_LIMIT_MAX=60
# 限流窗口（毫秒），默认 60000（60 秒）
RATE_LIMIT_WINDOW_MS=60000
# Redis 不可用时是否放行（true=降级放行，false=拒绝所有请求）
RATE_LIMIT_SKIP_ON_REDIS_DOWN=true
