# Server-side only. The REAL .env lives at /opt/bookconv-conversion/.env on the
# HK server and is generated there (openssl rand -hex 32). NEVER commit the secret.
#
# Generate:  openssl rand -hex 32
CONVERSION_INTERNAL_SECRET=REPLACE_WITH_openssl_rand_-hex_32

# Listen on loopback only; nginx (convert.tuozhigeo.com) fronts it publicly.
PORT=3001
BIND_HOST=127.0.0.1

# tmpfs mount (1G, noexec) — Calibre temp + outputs never touch the root disk
CONVERSION_TMP=/opt/bookconv-conversion/data/tmp
CONVERSION_LOG_DIR=/opt/bookconv-converter/logs

# Guards
MAX_FILE_BYTES=52428800
CALIBRE_TIMEOUT=120000
