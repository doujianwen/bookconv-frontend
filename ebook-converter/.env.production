# Redis
REDIS_URL=redis://your-redis-host:6379

# Upload config
UPLOAD_DIR=/tmp/ebook-uploads
MAX_FILE_SIZE_MB=10
CALIBRE_PATH=ebook-convert

# Cloudflare R2 (optional, falls back to local /tmp)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ebook-temp

# Supabase (optional, for authentication & user data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Rate Limiting ---
CONVERT_RATE_LIMIT_MAX=20
ANONYMOUS_RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_SKIP_ON_REDIS_DOWN=true

# --- CORS ---
CORS_ORIGINS=https://bookconv.com

# --- Lemon Squeezy (optional, for subscription payments) ---
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_PRO_MONTHLY_VARIANT_ID=
LEMON_SQUEEZY_API_MONTHLY_VARIANT_ID=
