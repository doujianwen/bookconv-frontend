#!/bin/sh
# bookconv pre-commit 钩子：提交前跑「快门禁」，把静默假成功挡在 commit 之前。
#
# 为什么加这道（2026-10-04 复盘结论）：
#   仓库有 51 个门禁脚本，但此前只有 pre-push、无 pre-commit。
#   而「静默假成功」这个头号失败模式恰恰发生在**提交之前**：
#   Edit 报 success 没改、门禁扫 0 文件、断言方向反、判据无法执行却报 PASS。
#   这些一旦 commit 成功，就会被 pre-push 的 slug 范围限定放行
#   （pre-push 只审本次 push 涉及的博文 slug，非博文文件根本不经它）。
#   换句话说：**脏东西在 commit 时就已入库，push 门禁看不见。**
#
# 设计原则（沿用 pre-push 的防「狼来了」纪律）：
#   - 只跑**快**门禁（实测 4 道合计约 6s），不拖慢提交；重门禁留给 pre-push / CI。
#   - fail-closed：node 缺失 / 脚本异常一律阻断，绝不静默放行。
#   - fail-open 豁免：仅对「未触及受管目录」的提交跳过，避免无关提交被误拦。
#   - SKIP 开关：SKIP_CONTENT_GATE=1 可跳过（逃生舱，用了会在输出里明示）。
#
# 挂载的门禁（2026-11-02：由 5 道扩为 6 道，新增文档自身完整性）：
#   1) syntax-sweep            TS 语法/结构（未闭合反引号、尖括号残留）
#   2) audit-content-integrity 内容完整性（空段、占位符、空承诺）
#   3) audit-workflow-integrity 门禁自身可信度（假挂载/越界路径/tee 吞退出码）
#   4) audit-agent-discipline  执行纪律（权威源漂移/挂载缺失/退出码不配对）
#   5) audit-heading-uniqueness heading 唯一性（防 #0 程序化页成果退化）
#   6) check-doc-integrity     文档自身完整性（章节号唯一 / 表格列数一致 / 百分比可回算）
#       —— 仅当本次提交触及 docs/ 时触发，且与 1~5 分离（避免 src 门禁误用到历史文档造成假失败）。
#   注意 3 与 4 互为反向验证：前者检查「workflow 引用的脚本是否真存在」，
#   后者检查「这些门禁自己是否真的被调用」——缺任一个都会让整套门禁形同虚设。
#
# 2026-11-07 工作流迭代 #1：本文件已入库到 ebook-converter/scripts/hooks/，
#   由 `core.hooksPath` 指向。.git/hooks/ 的旧副本在 hooksPath 生效时【不执行】；
#   新克隆/换机器只需 `git config core.hooksPath ebook-converter/scripts/hooks`，
#   不必手工复制文件。挂载是否生效由 `node scripts/verify-hook-mount.mjs` 机器判定。
#   ⚠️ 同目录必须同时放 pre-commit 与 pre-push —— 只搬一个会让另一个静默失效。
#
# 前置依赖：git 的 shell 环境中 `node` 必须在 PATH。

# 0) 挂载标记：可用 `git hook run pre-commit` 回读，证明执行的是入库版本而非 .git/hooks 旧副本
echo "[pre-commit] repo-tracked hook · hooksPath=ebook-converter/scripts/hooks"

# 0.1) node 可用性自检（fail-closed）
if ! command -v node >/dev/null 2>&1; then
  echo "⛔ pre-commit 门禁：未找到 node（git 的 shell 环境 PATH 中无 node），无法运行提交前审查。"
  echo "   请在 PATH 中加入 Node.js（managed node：C:/Users/29537/.workbuddy/binaries/node/versions/22.22.2/node.exe），再重试 commit。"
  exit 1
fi

REPO_ROOT=$(git rev-parse --show-toplevel)
APP="$REPO_ROOT/ebook-converter"

# 2026-11-07 工作流迭代 #5：UNKNOWN 不得显示成 ✅ 通过（治理协议 §5 / §9）。
#   check-doc-integrity 的 D3/D4 判据无法机械回算时输出 UNKNOWN，旧版只看退出码
#   就打印「✅ 通过」，把「未核验」伪装成「已验证」。现在解析汇总行做三态显示：
#   FAIL(非0退出) ⇒ 拦截；FAIL 0 但含 UNKNOWN ⇒ ⚠️ 放行且明示未核验；UNKNOWN 0 ⇒ ✅。
#   不改成硬拦截：历史文档存量 UNKNOWN 会天天拦提交，反而训练人用 --no-verify。
run_doc_integrity() {
  DOC_LOG=$(mktemp 2>/dev/null) || DOC_LOG="$APP/_wb_tmp/doc-integrity-hook.log"
  if ! node scripts/check-doc-integrity.mjs --governance > "$DOC_LOG" 2>&1; then
    cat "$DOC_LOG"
    rm -f "$DOC_LOG"
    echo "⛔ 提交被拦截：文档完整性门禁 FAIL（章节号重复 / 表格列数不一致 / 百分比回算不符）。修完再提交，勿用 --no-verify 绕过。"
    exit 1
  fi
  cat "$DOC_LOG"
  if grep -qE "UNKNOWN [1-9][0-9]*" "$DOC_LOG"; then
    UNK=$(grep -oE "UNKNOWN [1-9][0-9]*" "$DOC_LOG" | tail -1)
    echo "⚠️  docs 完整性门禁：放行（FAIL 0，但含 $UNK 未核验 —— UNKNOWN 不等于通过，须人工看）"
  else
    echo "✅ docs 完整性门禁通过（FAIL 0 / UNKNOWN 0）。"
  fi
  rm -f "$DOC_LOG"
}

# 1) 范围判定：staged 文件里有没有落在受管目录（src/ 与配置/门禁脚本）
# 2026-11-07：中文路径必须关掉 quotepath，否则 "docs/11月…md" 被转成八进制转义，
#   DOCS_SCOPE 恒空 ⇒ 文档门禁静默不跑，而收尾文案仍声称「文档完整性」已跑（假门禁）。
#   与下方 closure gate 段的写法保持一致。
STAGED=$(git -c core.quotepath=false diff --cached --name-only)
if [ -z "$STAGED" ]; then
  exit 0
fi

# 0.5) Closure Gate（2026-11-07 增补 · 防假关闭）：待办文件不在 src/docs 受管范围，
#      故必须在下方「范围短路 exit 0」之前独立触发。仅当待办被暂存时，跑 --no-live 确定性校验。
#      退出码映射：1=假关闭→拦截；2=无法核验→放行但告警（避免环境问题误拦、训练 --no-verify）；0=过。
CLOSURE_STAGED=$(git -c core.quotepath=false -C "$REPO_ROOT" diff --cached --name-only | grep -F "待办_2026-10-31_R2直传CORS与GA4行动项.md" || true)
if [ -n "$CLOSURE_STAGED" ]; then
  echo ">>> [closure] verify-closure-gates（--no-live，防假关闭）"
  node "$APP/scripts/verify-closure-gates.mjs" --no-live
  rc=$?
  if [ "$rc" -eq 1 ]; then
    echo "⛔ 提交被拦截：待办存在「假关闭」（关闭项验收 gate 未达成）。修 gate 或降级为「待观察」，勿用 --no-verify 绕过。"
    exit 1
  elif [ "$rc" -eq 2 ]; then
    echo "⚠️  closure-gate 无法核验（脚本异常/离线快照缺失），本次放行；建议手动跑 node scripts/verify-closure-gates.mjs。"
  fi
fi

# 1.1) 文档门禁范围（2026-11-02 追加）：本次提交触及 docs/ 即触发文档自身完整性门禁。
#      与 src 向门禁分离，避免把 src 门禁误用到历史文档上造成假失败（防「狼来了」）。
DOCS_SCOPE=$(printf '%s\n' "$STAGED" | grep -E "^ebook-converter/docs/" || true)

SCOPE=$(printf '%s\n' "$STAGED" | grep -E "^ebook-converter/(src/|scripts/|package\.json|tsconfig\.json|next\.config)|^\.github/workflows/" || true)

# 1.2) 纯文档提交：只跑文档完整性门禁，不跑 src 向 5 道（它们针对 src/，对历史文档会假失败）
if [ -n "$DOCS_SCOPE" ] && [ -z "$SCOPE" ]; then
  echo "⛔ pre-commit 门禁：本次提交仅触及 docs/，运行文档自身完整性门禁…"
  cd "$APP" || { echo "⛔ pre-commit 门禁：无法进入 $APP"; exit 1; }
  echo ">>> [docs] audit:doc-integrity（7 份治理文档：章节号唯一 / 表格列数一致 / 百分比可回算）"
  run_doc_integrity
  exit 0
fi

if [ -z "$SCOPE" ]; then
  # 既非 src 向、也非 docs（如 .workbuddy/、数据文件）⇒ 不拦，避免训练人忽略输出
  exit 0
fi

# 1.5) 逃生舱（明示，不静默）
if [ "$SKIP_CONTENT_GATE" = "1" ]; then
  echo "⚠️  pre-commit 门禁：已被 SKIP_CONTENT_GATE=1 显式跳过（本次提交未经快门禁验证）。"
  exit 0
fi

echo "⛔ pre-commit 门禁：本次提交触及受管目录（$(printf '%s\n' "$SCOPE" | wc -l | tr -d ' ') 个文件），运行快门禁…"

# 2) 快门禁 1：语法扫描（抓 TS 模板串/未闭合反引号/尖括号残留等结构性事故）
cd "$APP" || { echo "⛔ pre-commit 门禁：无法进入 $APP"; exit 1; }
echo ">>> [1/5] syntax-sweep"
if ! node scripts/syntax-sweep.mjs; then
  echo "⛔ 提交被拦截：syntax-sweep 报问题（TS 语法/结构）。修完再提交，勿用 --no-verify 绕过。"
  exit 1
fi

# 3) 快门禁 2：内容完整性（抓空段/占位符/空承诺；只在内容文件被改时才有意义，但很快）
echo ">>> [2/5] audit-content-integrity"
if ! node scripts/audit-content-integrity.mjs; then
  echo "⛔ 提交被拦截：audit-content-integrity 报问题（内容完整性）。修完再提交，勿用 --no-verify 绕过。"
  exit 1
fi

# 4) 快门禁 3：workflow 完整性（抓「看起来有门禁、实际跑不通」：未入库脚本 / ../../ 越界 / | tee 吞退出码 / 硬编码 token）
#    git 清单从 stdin 传入：Windows 下 Node 内 fork git 恒 EBUSY，脚本只读文件不 fork。
echo ">>> [3/5] audit-workflow-integrity"
if ! git -C "$REPO_ROOT" ls-files -z | node scripts/audit-workflow-integrity.mjs --tracked-from-stdin; then
  echo "⛔ 提交被拦截：audit-workflow-integrity 报问题（门禁自身可能是假门禁）。修完再提交，勿用 --no-verify 绕过。"
  exit 1
fi

# 5) 快门禁 4：执行纪律自检（防「路径靠猜 / 只看尾部就下结论 / 门禁没挂上」三类重复错误）
echo ">>> [4/5] audit-agent-discipline"
if ! node scripts/audit-agent-discipline.mjs; then
  echo "⛔ 提交被拦截：audit-agent-discipline 报问题（权威源漂移 / 门禁未挂载 / 退出码逻辑不配对）。"
  exit 1
fi

# 6) 快门禁 5：heading 唯一性（防 #0 程序化页差异化成果退化：共用 heading / 解析器失灵）
echo ">>> [5/5] audit-heading-uniqueness"
if ! node scripts/audit-heading-uniqueness.mjs; then
  echo "⛔ 提交被拦截：audit-heading-uniqueness 报问题（多页共用 heading，或 section 解析为 0）。"
  exit 1
fi

# 7) 文档自身完整性门禁（仅当本次也改了 docs/ 时；纯文档提交已在上方 1.2 分支单独跑过）
if [ -n "$DOCS_SCOPE" ]; then
  echo ">>> [docs] audit:doc-integrity（7 份治理文档：章节号唯一 / 表格列数一致 / 百分比可回算）"
  run_doc_integrity
fi

# 8) GA4 专属 selfTest（仅当本次提交触及 GA4 相关文件时；纯内存、不联网、fail-closed）
#    F26 (2026-11-05)：把 GA4 三道 selfTest（parser 131 项 / analysis 14 项含
#    attributionGuard / 跨模块契约）挂入 pre-commit，注入破坏性改动即被拦。
#    挂载点说明：.git/hooks/ 不入库，换机器需手动重装（同文件头部注释）。
GA4_SCOPE=$(printf '%s\n' "$STAGED" | grep -E "^ebook-converter/(scripts/(ga4-advanced-analysis|ga-inspection|lib/direct-upload-diagnostic|lib/ga-error-codes)\.mjs|src/lib/(direct-upload-error(\.test)?|client/direct-upload)\.ts|src/app/\[locale\]/convert/\[slug\]/ToolPageClient\.tsx)" || true)
if [ -n "$GA4_SCOPE" ]; then
  echo ">>> [GA4] direct-upload-diagnostic selfTest (131 项，纯内存)"
  if ! node scripts/lib/direct-upload-diagnostic.mjs --self-test; then
    echo "⛔ 提交被拦截：direct-upload-diagnostic selfTest FAIL（解析器/契约异常）。修完再提交，勿用 --no-verify 绕过。"
    exit 1
  fi
  echo ">>> [GA4] ga4-advanced-analysis selfTest (14 项含 attributionGuard)"
  if ! node scripts/ga4-advanced-analysis.mjs --self-test; then
    echo "⛔ 提交被拦截：ga4-advanced-analysis selfTest FAIL（解析/归因门禁异常）。修完再提交，勿用 --no-verify 绕过。"
    exit 1
  fi
  echo "✅ GA4 专属门禁通过。"
fi

echo "✅ pre-commit 快门禁通过（syntax-sweep + audit-content-integrity + audit-workflow-integrity + audit-agent-discipline + audit-heading-uniqueness + 文档完整性 + GA4 selfTest）。重门禁仍会在 push / CI 跑。"
exit 0
